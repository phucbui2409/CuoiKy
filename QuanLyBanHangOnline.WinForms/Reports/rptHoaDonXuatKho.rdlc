              <KeepWithGroup>After</KeepWithGroup>
              <RepeatOnNewPage>true</RepeatOnNewPage>
            </TablixMember>
            <TablixMember>
              <Group Name="Details" />
            </TablixMember>
          </TablixMembers>
        </TablixRowHierarchy>
        <DataSetName>DataSetChiTietDonHang</DataSetName>
        <Top>2.0in</Top>
        <Left>0.5in</Left>
        <Height>0.56in</Height>
        <Width>7.0in</Width>
      </Tablix>

      <!-- Khối tổng tiền thanh toán -->
      <Textbox Name="txtSummaryBlock">
        <CanGrow>true</CanGrow>
        <KeepTogether>true</KeepTogether>
        <Paragraphs>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>Tổng tiền thanh toán: </Value>
                <Style><FontFamily>Segoe UI</FontFamily><FontSize>11pt</FontSize><FontWeight>Bold</FontWeight></Style>
              </TextRun>
              <TextRun>
                <Value>=Parameters!pTongTien.Value</Value>
                <Style><FontFamily>Segoe UI</FontFamily><FontSize>13pt</FontSize><FontWeight>Bold</FontWeight><Color>#C53030</Color></Style>
              </TextRun>
              <TextRun>
                <Value>  VND</Value>
                <Style><FontFamily>Segoe UI</FontFamily><FontSize>11pt</FontSize><FontWeight>Bold</FontWeight></Style>
              </TextRun>
            </TextRuns>
            <Style><TextAlign>Right</TextAlign></Style>
          </Paragraph>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>Bằng chữ: </Value>
                <Style><FontFamily>Segoe UI</FontFamily><FontWeight>Bold</FontWeight><FontStyle>Italic</FontStyle></Style>
              </TextRun>
              <TextRun>
                <Value>=Parameters!pTongTienChu.Value</Value>
                <Style><FontFamily>Segoe UI</FontFamily><FontStyle>Italic</FontStyle></Style>
              </TextRun>
            </TextRuns>
            <Style><TextAlign>Right</TextAlign></Style>
          </Paragraph>
        </Paragraphs>
        <Top>2.65in</Top>
        <Left>1.5in</Left>
        <Height>0.55in</Height>
        <Width>6.0in</Width>
      </Textbox>

      <!-- Khối chữ ký 3 bên -->
      <Textbox Name="txtSignatures">
        <CanGrow>true</CanGrow>
        <KeepTogether>true</KeepTogether>
        <Paragraphs>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>    Khách Hàng Nhận                     Thủ Kho Xuất Hàng                     Người Lập Phiếu</Value>
                <Style><FontFamily>Segoe UI</FontFamily><FontSize>10pt</FontSize><FontWeight>Bold</FontWeight></Style>
              </TextRun>
            </TextRuns>
          </Paragraph>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>    (Ký, ghi rõ họ tên)                      (Ký, ghi rõ họ tên)                       (Ký, ghi rõ họ tên)</Value>
                <Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><FontStyle>Italic</FontStyle><Color>#718096</Color></Style>
              </TextRun>
            </TextRuns>
          </Paragraph>
        </Paragraphs>
        <Top>3.35in</Top>
        <Left>0.5in</Left>
        <Height>0.85in</Height>
        <Width>7.0in</Width>
      </Textbox>

    </ReportItems>
    <Height>4.3in</Height>
    <Style />
  </Body>

  <!-- Danh sách tham số nhận từ C# ReportParameter -->
  <ReportParameters>
    <ReportParameter Name="pMaHD"><DataType>String</DataType><Prompt>pMaHD</Prompt></ReportParameter>
    <ReportParameter Name="pNgayLap"><DataType>String</DataType><Prompt>pNgayLap</Prompt></ReportParameter>
    <ReportParameter Name="pTenKhachHang"><DataType>String</DataType><Prompt>pTenKhachHang</Prompt></ReportParameter>
    <ReportParameter Name="pDiaChi"><DataType>String</DataType><Prompt>pDiaChi</Prompt></ReportParameter>
    <ReportParameter Name="pSoDienThoai"><DataType>String</DataType><Prompt>pSoDienThoai</Prompt></ReportParameter>
    <ReportParameter Name="pNhanVienLap"><DataType>String</DataType><Prompt>pNhanVienLap</Prompt></ReportParameter>
    <ReportParameter Name="pTrangThai"><DataType>String</DataType><Prompt>pTrangThai</Prompt></ReportParameter>
    <ReportParameter Name="pTongTien"><DataType>String</DataType><Prompt>pTongTien</Prompt></ReportParameter>
    <ReportParameter Name="pTongTienChu"><DataType>String</DataType><Prompt>pTongTienChu</Prompt></ReportParameter>
    <ReportParameter Name="pGhiChu"><DataType>String</DataType><Nullable>true</Nullable><Prompt>pGhiChu</Prompt></ReportParameter>
  </ReportParameters>

  <!-- Danh sách trường dữ liệu nhận từ C# ReportDataSource -->
  <DataSets>
    <DataSet Name="DataSetChiTietDonHang">
      <Query>
        <DataSourceName>DummyDataSource</DataSourceName>
        <CommandText />
      </Query>
      <Fields>
        <Field Name="STT"><DataField>STT</DataField><rd:TypeName>System.Int32</rd:TypeName></Field>
        <Field Name="MaHang"><DataField>MaHang</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="TenHang"><DataField>TenHang</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="MauSac"><DataField>MauSac</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="SoLuong"><DataField>SoLuong</DataField><rd:TypeName>System.Int32</rd:TypeName></Field>
        <Field Name="DonGia"><DataField>DonGia</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field>
        <Field Name="ThanhTien"><DataField>ThanhTien</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field>
      </Fields>
    </DataSet>
  </DataSets>

  <Width>7.8in</Width>
  <Page>
    <LeftMargin>0.4in</LeftMargin>
    <RightMargin>0.4in</RightMargin>
    <TopMargin>0.4in</TopMargin>
    <BottomMargin>0.4in</BottomMargin>
