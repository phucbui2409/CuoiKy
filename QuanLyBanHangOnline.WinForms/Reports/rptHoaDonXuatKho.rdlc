<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2008/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <Body>
    <ReportItems>
      <!-- Tiêu đề cửa hàng -->
      <Textbox Name="txtShopName">
        <CanGrow>true</CanGrow>
        <KeepTogether>true</KeepTogether>
        <Paragraphs>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>HỆ THỐNG QUẢN LÝ BÁN HÀNG ONLINE</Value>
                <Style>
                  <FontFamily>Segoe UI</FontFamily>
                  <FontSize>11pt</FontSize>
                  <FontWeight>Bold</FontWeight>
                  <Color>#2B6CB0</Color>
                </Style>
              </TextRun>
            </TextRuns>
            <Style>
              <TextAlign>Center</TextAlign>
            </Style>
          </Paragraph>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>Địa chỉ: 123 Đường Điện Biên Phủ, TP. Hồ Chí Minh - Hotline: 1900 6868</Value>
                <Style>
                  <FontFamily>Segoe UI</FontFamily>
                  <FontSize>9pt</FontSize>
                  <Color>#718096</Color>
                </Style>
              </TextRun>
            </TextRuns>
            <Style>
              <TextAlign>Center</TextAlign>
            </Style>
          </Paragraph>
        </Paragraphs>
        <Top>0.1in</Top>
        <Left>0.5in</Left>
        <Height>0.45in</Height>
        <Width>6.5in</Width>
      </Textbox>

      <!-- Tiêu đề hóa đơn -->
      <Textbox Name="txtReportTitle">
        <CanGrow>true</CanGrow>
        <KeepTogether>true</KeepTogether>
        <Paragraphs>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>HÓA ĐƠN BÁN HÀNG &amp; PHIẾU XUẤT KHO</Value>
                <Style>
                  <FontFamily>Segoe UI</FontFamily>
                  <FontSize>16pt</FontSize>
                  <FontWeight>Bold</FontWeight>
                  <Color>#1A202C</Color>
                </Style>
              </TextRun>
            </TextRuns>
            <Style>
              <TextAlign>Center</TextAlign>
            </Style>
          </Paragraph>
        </Paragraphs>
        <Top>0.6in</Top>
        <Left>0.5in</Left>
        <Height>0.35in</Height>
        <Width>6.5in</Width>
      </Textbox>

      <!-- Khối thông tin hóa đơn & khách hàng (2 cột) -->
      <Textbox Name="txtOrderInfoLeft">
        <CanGrow>true</CanGrow>
        <KeepTogether>true</KeepTogether>
        <Paragraphs>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>Mã đơn hàng: </Value>
                <Style><FontFamily>Segoe UI</FontFamily><FontWeight>Bold</FontWeight></Style>
              </TextRun>
              <TextRun>
                <Value>=Parameters!pMaHD.Value</Value>
                <Style><FontFamily>Segoe UI</FontFamily><FontWeight>Bold</FontWeight><Color>#C53030</Color></Style>
              </TextRun>
            </TextRuns>
          </Paragraph>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>Ngày đặt hàng: </Value>
                <Style><FontFamily>Segoe UI</FontFamily><FontWeight>Bold</FontWeight></Style>
              </TextRun>
              <TextRun>
                <Value>=Parameters!pNgayLap.Value</Value>
                <Style><FontFamily>Segoe UI</FontFamily></Style>
              </TextRun>
            </TextRuns>
          </Paragraph>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>Nhân viên lập / duyệt: </Value>
                <Style><FontFamily>Segoe UI</FontFamily><FontWeight>Bold</FontWeight></Style>
              </TextRun>
              <TextRun>
                <Value>=Parameters!pNhanVienLap.Value</Value>
                <Style><FontFamily>Segoe UI</FontFamily></Style>
              </TextRun>
            </TextRuns>
          </Paragraph>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>Trạng thái: </Value>
                <Style><FontFamily>Segoe UI</FontFamily><FontWeight>Bold</FontWeight></Style>
              </TextRun>
              <TextRun>
                <Value>=Parameters!pTrangThai.Value</Value>
                <Style><FontFamily>Segoe UI</FontFamily><Color>#2F855A</Color><FontWeight>Bold</FontWeight></Style>
              </TextRun>
            </TextRuns>
          </Paragraph>
        </Paragraphs>
        <Top>1.05in</Top>
        <Left>0.5in</Left>
        <Height>0.85in</Height>
        <Width>3.1in</Width>
      </Textbox>

      <Textbox Name="txtCustomerInfoRight">
        <CanGrow>true</CanGrow>
        <KeepTogether>true</KeepTogether>
        <Paragraphs>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>Khách hàng: </Value>
                <Style><FontFamily>Segoe UI</FontFamily><FontWeight>Bold</FontWeight></Style>
              </TextRun>
              <TextRun>
                <Value>=Parameters!pTenKhachHang.Value</Value>
                <Style><FontFamily>Segoe UI</FontFamily></Style>
              </TextRun>
            </TextRuns>
          </Paragraph>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>Điện thoại: </Value>
                <Style><FontFamily>Segoe UI</FontFamily><FontWeight>Bold</FontWeight></Style>
              </TextRun>
              <TextRun>
                <Value>=Parameters!pSoDienThoai.Value</Value>
                <Style><FontFamily>Segoe UI</FontFamily></Style>
              </TextRun>
            </TextRuns>
          </Paragraph>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>Địa chỉ nhận: </Value>
                <Style><FontFamily>Segoe UI</FontFamily><FontWeight>Bold</FontWeight></Style>
              </TextRun>
              <TextRun>
                <Value>=Parameters!pDiaChi.Value</Value>
                <Style><FontFamily>Segoe UI</FontFamily></Style>
              </TextRun>
            </TextRuns>
          </Paragraph>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>Ghi chú: </Value>
                <Style><FontFamily>Segoe UI</FontFamily><FontWeight>Bold</FontWeight></Style>
              </TextRun>
              <TextRun>
                <Value>=Parameters!pGhiChu.Value</Value>
                <Style><FontFamily>Segoe UI</FontFamily></Style>
              </TextRun>
            </TextRuns>
          </Paragraph>
        </Paragraphs>
        <Top>1.05in</Top>
        <Left>3.8in</Left>
        <Height>0.85in</Height>
        <Width>3.2in</Width>
      </Textbox>

      <!-- Bảng chi tiết sản phẩm Tablix -->
      <Tablix Name="TablixChiTiet">
        <TablixBody>
          <TablixColumns>
            <TablixColumn><Width>0.4in</Width></TablixColumn>
            <TablixColumn><Width>0.8in</Width></TablixColumn>
            <TablixColumn><Width>2.4in</Width></TablixColumn>
            <TablixColumn><Width>0.8in</Width></TablixColumn>
            <TablixColumn><Width>0.6in</Width></TablixColumn>
            <TablixColumn><Width>1.0in</Width></TablixColumn>
            <TablixColumn><Width>1.0in</Width></TablixColumn>
          </TablixColumns>
          <TablixRows>
            <!-- Tiêu đề bảng -->
            <TablixRow>
              <Height>0.3in</Height>
              <TablixCells>
                <TablixCell>
                  <CellContents>
                    <Textbox Name="hdrSTT">
                      <Paragraphs><Paragraph><TextRuns><TextRun><Value>STT</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>9pt</FontSize><FontWeight>Bold</FontWeight><Color>White</Color></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs>
                      <Style><BackgroundColor>#2B6CB0</BackgroundColor><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>4pt</PaddingTop><PaddingBottom>4pt</PaddingBottom><BorderStyle><Default>Solid</Default></BorderStyle><BorderColor><Default>#CBD5E0</Default></BorderColor></Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>
                <TablixCell>
                  <CellContents>
                    <Textbox Name="hdrMaHang">
                      <Paragraphs><Paragraph><TextRuns><TextRun><Value>Mã Hàng</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>9pt</FontSize><FontWeight>Bold</FontWeight><Color>White</Color></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs>
                      <Style><BackgroundColor>#2B6CB0</BackgroundColor><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>4pt</PaddingTop><PaddingBottom>4pt</PaddingBottom><BorderStyle><Default>Solid</Default></BorderStyle><BorderColor><Default>#CBD5E0</Default></BorderColor></Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>
                <TablixCell>
                  <CellContents>
                    <Textbox Name="hdrTenHang">
                      <Paragraphs><Paragraph><TextRuns><TextRun><Value>Tên Hàng Hóa / Sản Phẩm</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>9pt</FontSize><FontWeight>Bold</FontWeight><Color>White</Color></Style></TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs>
                      <Style><BackgroundColor>#2B6CB0</BackgroundColor><PaddingLeft>4pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>4pt</PaddingTop><PaddingBottom>4pt</PaddingBottom><BorderStyle><Default>Solid</Default></BorderStyle><BorderColor><Default>#CBD5E0</Default></BorderColor></Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>
                <TablixCell>
                  <CellContents>
                    <Textbox Name="hdrMauSac">
                      <Paragraphs><Paragraph><TextRuns><TextRun><Value>Màu Sắc</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>9pt</FontSize><FontWeight>Bold</FontWeight><Color>White</Color></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs>
                      <Style><BackgroundColor>#2B6CB0</BackgroundColor><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>4pt</PaddingTop><PaddingBottom>4pt</PaddingBottom><BorderStyle><Default>Solid</Default></BorderStyle><BorderColor><Default>#CBD5E0</Default></BorderColor></Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>
                <TablixCell>
                  <CellContents>
                    <Textbox Name="hdrSoLuong">
                      <Paragraphs><Paragraph><TextRuns><TextRun><Value>SL</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>9pt</FontSize><FontWeight>Bold</FontWeight><Color>White</Color></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs>
                      <Style><BackgroundColor>#2B6CB0</BackgroundColor><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>4pt</PaddingTop><PaddingBottom>4pt</PaddingBottom><BorderStyle><Default>Solid</Default></BorderStyle><BorderColor><Default>#CBD5E0</Default></BorderColor></Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>
                <TablixCell>
                  <CellContents>
                    <Textbox Name="hdrDonGia">
                      <Paragraphs><Paragraph><TextRuns><TextRun><Value>Đơn Giá (VND)</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>9pt</FontSize><FontWeight>Bold</FontWeight><Color>White</Color></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs>
                      <Style><BackgroundColor>#2B6CB0</BackgroundColor><PaddingLeft>2pt</PaddingLeft><PaddingRight>4pt</PaddingRight><PaddingTop>4pt</PaddingTop><PaddingBottom>4pt</PaddingBottom><BorderStyle><Default>Solid</Default></BorderStyle><BorderColor><Default>#CBD5E0</Default></BorderColor></Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>
                <TablixCell>
                  <CellContents>
                    <Textbox Name="hdrThanhTien">
                      <Paragraphs><Paragraph><TextRuns><TextRun><Value>Thành Tiền (VND)</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>9pt</FontSize><FontWeight>Bold</FontWeight><Color>White</Color></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs>
                      <Style><BackgroundColor>#2B6CB0</BackgroundColor><PaddingLeft>2pt</PaddingLeft><PaddingRight>4pt</PaddingRight><PaddingTop>4pt</PaddingTop><PaddingBottom>4pt</PaddingBottom><BorderStyle><Default>Solid</Default></BorderStyle><BorderColor><Default>#CBD5E0</Default></BorderColor></Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>
              </TablixCells>
            </TablixRow>

            <!-- Dòng dữ liệu -->
            <TablixRow>
              <Height>0.26in</Height>
              <TablixCells>
                <TablixCell>
                  <CellContents>
                    <Textbox Name="colSTT">
                      <Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!STT.Value</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>9pt</FontSize></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs>
                      <Style><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>3pt</PaddingTop><PaddingBottom>3pt</PaddingBottom><BorderStyle><Default>Solid</Default></BorderStyle><BorderColor><Default>#E2E8F0</Default></BorderColor></Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>
                <TablixCell>
                  <CellContents>
                    <Textbox Name="colMaHang">
                      <Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!MaHang.Value</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>9pt</FontSize><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs>
                      <Style><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>3pt</PaddingTop><PaddingBottom>3pt</PaddingBottom><BorderStyle><Default>Solid</Default></BorderStyle><BorderColor><Default>#E2E8F0</Default></BorderColor></Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>
                <TablixCell>
                  <CellContents>
                    <Textbox Name="colTenHang">
                      <Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!TenHang.Value</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>9pt</FontSize></Style></TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs>
                      <Style><PaddingLeft>4pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>3pt</PaddingTop><PaddingBottom>3pt</PaddingBottom><BorderStyle><Default>Solid</Default></BorderStyle><BorderColor><Default>#E2E8F0</Default></BorderColor></Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>
                <TablixCell>
                  <CellContents>
                    <Textbox Name="colMauSac">
                      <Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!MauSac.Value</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>9pt</FontSize></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs>
                      <Style><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>3pt</PaddingTop><PaddingBottom>3pt</PaddingBottom><BorderStyle><Default>Solid</Default></BorderStyle><BorderColor><Default>#E2E8F0</Default></BorderColor></Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>
                <TablixCell>
                  <CellContents>
                    <Textbox Name="colSoLuong">
                      <Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!SoLuong.Value</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>9pt</FontSize><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs>
                      <Style><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>3pt</PaddingTop><PaddingBottom>3pt</PaddingBottom><BorderStyle><Default>Solid</Default></BorderStyle><BorderColor><Default>#E2E8F0</Default></BorderColor></Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>
                <TablixCell>
                  <CellContents>
                    <Textbox Name="colDonGia">
                      <Paragraphs><Paragraph><TextRuns><TextRun><Value>=Format(Fields!DonGia.Value, "N0")</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>9pt</FontSize></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs>
                      <Style><PaddingLeft>2pt</PaddingLeft><PaddingRight>4pt</PaddingRight><PaddingTop>3pt</PaddingTop><PaddingBottom>3pt</PaddingBottom><BorderStyle><Default>Solid</Default></BorderStyle><BorderColor><Default>#E2E8F0</Default></BorderColor></Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>
                <TablixCell>
                  <CellContents>
                    <Textbox Name="colThanhTien">
                      <Paragraphs><Paragraph><TextRuns><TextRun><Value>=Format(Fields!ThanhTien.Value, "N0")</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>9pt</FontSize><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs>
                      <Style><PaddingLeft>2pt</PaddingLeft><PaddingRight>4pt</PaddingRight><PaddingTop>3pt</PaddingTop><PaddingBottom>3pt</PaddingBottom><BorderStyle><Default>Solid</Default></BorderStyle><BorderColor><Default>#E2E8F0</Default></BorderColor></Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>
              </TablixCells>
            </TablixRow>
          </TablixRows>
        </TablixBody>
        <TablixColumnHierarchy>
          <TablixMembers>
            <TablixMember />
            <TablixMember />
            <TablixMember />
            <TablixMember />
            <TablixMember />
            <TablixMember />
            <TablixMember />
          </TablixMembers>
        </TablixColumnHierarchy>
        <TablixRowHierarchy>
